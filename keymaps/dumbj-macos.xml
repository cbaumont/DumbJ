<keymap name="DumbJ macOS" parent="Mac OS X 10.5+" version="1">
  <action id="ActivateCommitToolWindow"/>
  <action id="ActivateServicesToolWindow"/>
  <action id="DumbJ.ActivateReviewToolWindow">
    <keyboard-shortcut first-keystroke="meta 0"/>
    <keyboard-shortcut first-keystroke="control alt shift Y"/>
  </action>
  <action id="DumbJ.Review.Start">
    <keyboard-shortcut first-keystroke="control alt shift K"/>
  </action>
  <action id="DumbJ.Review.ToggleFileViewed">
    <keyboard-shortcut first-keystroke="control alt shift U"/>
  </action>
  <action id="DumbJ.Review.NextUnviewedFile">
    <keyboard-shortcut first-keystroke="control alt shift X"/>
  </action>
  <action id="DumbJ.Review.AddNote">
    <keyboard-shortcut first-keystroke="control alt shift M"/>
  </action>
  <action id="DumbJ.Review.PullRequests">
    <keyboard-shortcut first-keystroke="meta 8"/>
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="P"/>
  </action>
  <action id="DumbJ.Review.OpenInBrowser">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="O"/>
  </action>
  <action id="DumbJ.Review.NextThread">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="N"/>
  </action>
  <action id="DumbJ.Review.PreviousThread">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="B"/>
  </action>
  <action id="DumbJ.Review.ToggleThread">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="T"/>
  </action>
  <action id="DumbJ.Review.AddComment">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="C"/>
  </action>
  <action id="DumbJ.Review.Reply">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="R"/>
  </action>
  <action id="DumbJ.Review.ResolveThread">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="X"/>
  </action>
  <action id="DumbJ.Review.Submit">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="S"/>
  </action>
  <action id="DumbJ.Review.Approve">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="A"/>
  </action>
  <action id="DumbJ.Review.RequestChanges">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="Q"/>
  </action>
  <action id="DumbJ.Review.InsertSuggestion">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="G"/>
  </action>
  <action id="DumbJ.Review.SendNow">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="ENTER"/>
  </action>
  <action id="DumbJ.Review.Send">
    <keyboard-shortcut first-keystroke="control alt shift ENTER"/>
  </action>
  <action id="DumbJ.Review.Overview">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="D"/>
  </action>
  <action id="DumbJ.Review.CopyPermalink">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="L"/>
  </action>
  <action id="DumbJ.Review.PruneRefs">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="Z"/>
  </action>
  <action id="DumbJ.ShowFileHistory">
    <keyboard-shortcut first-keystroke="control alt shift Q"/>
  </action>
  <action id="DumbJ.ShowHistoryForSelection">
    <keyboard-shortcut first-keystroke="control alt shift Z"/>
  </action>
  <action id="DumbJ.Annotate">
    <keyboard-shortcut first-keystroke="control alt shift A"/>
  </action>
  <action id="DumbJ.Branches">
    <keyboard-shortcut first-keystroke="control alt shift N"/>
  </action>
</keymap>
