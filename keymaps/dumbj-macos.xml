<keymap name="DumbJ macOS" parent="Mac OS X 10.5+" version="1">
  <action id="DumbJ.ActivateReviewToolWindow">
    <keyboard-shortcut first-keystroke="control alt shift Y"/>
  </action>
  <action id="DumbJ.Review.Start">
    <keyboard-shortcut first-keystroke="control alt shift K"/>
  </action>
  <action id="DumbJ.Review.ToggleFileViewed">
    <keyboard-shortcut first-keystroke="control alt shift U"/>
  </action>
  <action id="DumbJ.Review.NextUnviewedFile">
    <keyboard-shortcut first-keystroke="control alt shift X"/>
  </action>
  <action id="DumbJ.Review.AddNote">
    <keyboard-shortcut first-keystroke="control alt shift M"/>
  </action>
  <action id="DumbJ.Review.PullRequests">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="P"/>
  </action>
  <action id="DumbJ.Review.OpenInBrowser">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="O"/>
  </action>
  <action id="DumbJ.Review.NextThread">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="N"/>
  </action>
  <action id="DumbJ.Review.PreviousThread">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="B"/>
  </action>
  <action id="DumbJ.Review.ToggleThread">
    <keyboard-shortcut first-keystroke="control alt shift P" second-keystroke="T"/>
  </action>
  <action id="DumbJ.ShowFileHistory">
    <keyboard-shortcut first-keystroke="control alt shift Q"/>
  </action>
  <action id="DumbJ.ShowHistoryForSelection">
    <keyboard-shortcut first-keystroke="control alt shift Z"/>
  </action>
  <action id="DumbJ.Annotate">
    <keyboard-shortcut first-keystroke="control alt shift A"/>
  </action>
  <action id="DumbJ.Branches">
    <keyboard-shortcut first-keystroke="control alt shift N"/>
  </action>
</keymap>
